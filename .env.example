# 🔑 کلیدهای API و تنظیمات عملیاتی پلتفرم ایجنت‌های واردات

# سرور
PORT=8000
HOST=0.0.0.0
ENV=production

# کلید هوش مصنوعی DeepSeek (DeepSeek-V3 / DeepSeek-R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# کلید هوش مصنوعی (OpenAI / Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# توکن ربات تلگرام (از BotFather@)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# تنظیمات سامانه اعتبارسنجی چین QCC
QCC_API_KEY=
QCC_SECRET=

# پایگاه داده
DATABASE_URL=sqlite:///./import_agents.db

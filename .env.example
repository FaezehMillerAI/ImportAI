# 🔑 کلیدهای API و تنظیمات عملیاتی پلتفرم ایجنت‌های واردات

# سرور
PORT=8000
HOST=0.0.0.0
ENV=production

# کلید هوش مصنوعی (OpenAI / Gemini / Claude)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# توکن ربات تلگرام (از BotFather@)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# تنظیمات سامانه اعتبارسنجی چین QCC
QCC_API_KEY=your_qcc_api_key_here
QCC_SECRET=your_qcc_secret_here

# پایگاه داده
DATABASE_URL=sqlite:///./import_agents.db
